<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="refreshInterval" type="Int">
      <default>300</default>
      <min>30</min>
      <max>86400</max>
    </entry>
    <entry name="panelMetric" type="Int">
      <default>0</default>
    </entry>
    <!-- The add-style panel composition: one entry per checked metric in the
         settings, comma-free (StringList). Ids are the METRIC_* constants in
         contents/ui/js/format.js. Empty is the pre-composition state and
         falls back to panelMetric; "10" alone means "nothing checked", i.e.
         icon only, so an explicit empty choice survives a restart. -->
    <entry name="panelMetrics" type="StringList">
      <default></default>
    </entry>
    <entry name="costPeriodDays" type="Int">
      <default>30</default>
      <min>1</min>
      <!-- The platform answers at most a 31-day usage window; see
           MAX_USAGE_DAYS in contents/ui/js/api.js, which the settings page and the
           request both read. 32 days is refused with INVALID_PARAM. -->
      <max>31</max>
    </entry>
    <entry name="hideAmounts" type="Bool">
      <default>false</default>
    </entry>
    <!-- Show each panel number's provider icon on the chip. Off by default:
         several checked metrics with an icon each crowd a panel row. -->
    <entry name="showProviderIcons" type="Bool">
      <default>false</default>
    </entry>
    <!-- Not a secret, so unlike the keys it lives in the config file. Empty
         takes the default in contents/ui/js/kimi.js (normalizeBaseUrl). -->
    <entry name="kimiBaseUrl" type="String">
      <default>https://api.kimi.com/coding/v1</default>
    </entry>
    <!-- Same deal as kimiBaseUrl; default in contents/ui/js/zai.js. -->
    <entry name="zaiBaseUrl" type="String">
      <default>https://api.z.ai</default>
    </entry>
    <!-- The quota trend's recorded points: a compact JSON array written by
         the applet itself (js/history.js), read by nobody else. Capped in
         size there, so the entry cannot grow without bound. -->
    <entry name="usageHistory" type="String">
      <default></default>
    </entry>
    <!-- The day (js/reminder.js epochDay) the weekly-quota reminder last went
         out per provider, so it fires at most once a day. -->
    <entry name="kimiReminderDay" type="Int">
      <default>0</default>
    </entry>
    <entry name="zaiReminderDay" type="Int">
      <default>0</default>
    </entry>
    <!-- The reminders' knobs (defaults mirror the constants in
         contents/ui/js/reminder.js, which the settings override). -->
    <entry name="resetReminderEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="resetReminderHours" type="Int">
      <default>24</default>
      <min>1</min>
      <max>72</max>
    </entry>
    <entry name="resetReminderPercent" type="Int">
      <default>20</default>
      <min>0</min>
      <max>90</max>
    </entry>
    <entry name="dailyDigestEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="digestTime1" type="String">
      <default>09:00</default>
    </entry>
    <entry name="digestTime2" type="String">
      <default>21:00</default>
    </entry>
    <!-- Local-day stamps per digest slot (js/reminder.js localDay). -->
    <entry name="digestDay1" type="Int">
      <default>0</default>
    </entry>
    <entry name="digestDay2" type="Int">
      <default>0</default>
    </entry>
    <!-- Bumped by the config page after secrets are written to KWallet so the
         applet re-reads them. -->
    <entry name="secretsRevision" type="Int">
      <default>0</default>
    </entry>
  </group>
</kcfg>

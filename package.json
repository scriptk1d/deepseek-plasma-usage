{
    "name": "deepseek-plasma-usage",
    "version": "0.4.0",
    "private": true,
    "description": "A dependency-free KDE Plasma 6 widget showing DeepSeek API balance and usage across all your API keys",
    "license": "GPL-2.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/marble-sh/deepseek-plasma-usage.git"
    },
    "scripts": {
        "test": "node --test tests/*.test.mjs",
        "lint:qml": "tests/lint-qml.sh",
        "check:po": "./translate/build.sh --check",
        "check:pot": "./translate/merge.sh --check",
        "audit": "npm audit --audit-level=high",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gauntlet": "scripts/gauntlet.sh",
        "hooks": "scripts/install-hooks.sh"
    },
    "devDependencies": {
        "prettier": "3.9.9"
    }
}
